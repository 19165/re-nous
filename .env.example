# ==========================================
# 🌸 Multi-Agent Research Assistant v1.0.0
# Environment Configuration Template
# ==========================================

# --- LLM & Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Role-Based Generation Token Limits (num_predict)
MAX_TOKENS_PLANNER=1200
MAX_TOKENS_QUERY_OPT=150
MAX_TOKENS_SUPERVISOR=1500
MAX_TOKENS_WRITER=4000

# --- Search Configuration (Tavily) ---
TAVILY_API_KEY=tvly-your-api-key-here
TAVILY_CHUNKS_PER_SOURCE=3
TAVILY_INCLUDE_RAW_CONTENT=false
MAX_RAW_CONTENT_CHARS=2500

# --- Tier 1 Storage: Redis (In-Flight State, Cache & SSE Pub/Sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400

# --- Tier 2 Storage: PostgreSQL (Permanent Runs & Step-Level Traces) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_db

# --- Research Budget & Gatekeeper Constraints ---
MAX_SUB_QUESTIONS=3
MAX_SEARCHES_PER_SUB_QUESTION=2
MAX_SOURCES_PER_DOMAIN_SUB_Q=1
MAX_TOTAL_TOKENS=16000
WALL_CLOCK_TIMEOUT_SECONDS=60.0
MAX_REVISIONS=1
